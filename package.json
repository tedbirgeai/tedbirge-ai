{
  "name": "tedbirge-ai",
  "version": "1.14.0",
  "description": "Tedbirge AI local sqlite backend",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "ocr:worker": "node scripts/ocr-worker.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "postinstall": "prisma generate && prisma migrate deploy && node scripts/apply-pending-schemas.js && node scripts/seed-role-permissions.js",
    "seed": "node src/seed/seed.js",
    "test": "jest",
    "test:smoke": "node -e \"console.log('ok')\"",
    "os:update": "node scripts/auto-update.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.89.0",
    "@prisma/client": "^6.19.2",
    "@supabase/supabase-js": "^2.103.3",
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "uuid": "^11.1.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.1.9",
    "pg": "^8.20.0",
    "prisma": "^6.19.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
