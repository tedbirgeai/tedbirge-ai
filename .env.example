# ─────────────────────────────────────────────────────────────────────────────
# Tedbirge AI — Backend Environment Variables
# Kopyala: cp .env.example .env   (sonra değerleri doldur)
# ─────────────────────────────────────────────────────────────────────────────

# ── Sunucu ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
APP_URL=https://api.tedbirge.ai

# ── CORS ──────────────────────────────────────────────────────────────────────
# Virgülle ayrılmış izinli originler (örn: https://tedbirge.ai,https://www.tedbirge.ai)
CORS_ORIGIN=https://tedbirge.ai

# ── Panel URL (sifre sifirlama + email dogrulama linklerinde kullanilir) ───────
PANEL_URL=https://www.tedbirge.ai

# ── Auth ──────────────────────────────────────────────────────────────────────
# openssl rand -hex 32  ile üret
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h

# ── Veritabanı ────────────────────────────────────────────────────────────────
# Supabase: Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres?connection_limit=20&pool_timeout=30

# ── Dosya Yükleme ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# Supabase Storage (deploy'da uploads/ yerine kullanılır)
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_STORAGE_BUCKET=tedbirge-uploads

# ── AI / Analiz ───────────────────────────────────────────────────────────────
# mock | hybrid | real
ANALYSIS_MODE=real
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── OCR ───────────────────────────────────────────────────────────────────────
# tesseract | ocr_space
OCR_PROVIDER=tesseract
# Linux (Railway): /usr/bin/tesseract
# macOS (Homebrew): /opt/homebrew/bin/tesseract
TESSERACT_PATH=/usr/bin/tesseract
OCR_LANG=tur+eng
OCR_PSM=6
OCR_DPI=150
# Railway/Docker'da poppler-utils paketi kurulu olmalı
PDFTOPPM_PATH=/usr/bin/pdftoppm

# ── SMS — Netgsm ──────────────────────────────────────────────────────────────
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_HEADER=TEDBIRGE

# ── E-posta — Gmail SMTP ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
# Gmail Uygulama Şifresi: Google Account → Security → App Passwords
SMTP_PASS=xxxx xxxx xxxx xxxx
# Reply-To adresi (boş bırakılırsa SMTP_USER kullanılır)
SMTP_REPLY_TO=destek@tedbirge.ai

# ── WhatsApp Business API ─────────────────────────────────────────────────────
WHATSAPP_DEFAULT_NUMBER=905XXXXXXXXX
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v19.0
# Webhook imza doğrulaması için Meta App Secret (Meta Developer → App Settings → Basic)
WHATSAPP_APP_SECRET=

# Onaylı şablon mesajı adları (Meta Business Manager'da onaylananlar)
WA_TEMPLATE_YENI_BASVURU=yeni_basvuru
WA_TEMPLATE_AVUKAT_ATAMA=avukat_atama
# Webhook doğrulama tokeni (Meta Developer → Webhook → Verify Token alanına aynı değeri gir)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=tedbirge-webhook-secret-2026

# ── Web Push (PWA Bildirimler) ────────────────────────────────────────────────
# Üretmek için: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(JSON.stringify(k))"
VAPID_PUBLIC_KEY=REPLACE_WITH_GENERATED_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_GENERATED_PRIVATE_KEY
VAPID_SUBJECT=mailto:your@email.com

# ── OCR Worker Ayarları ───────────────────────────────────────────────────────
OCR_POLL_INTERVAL_MS=10000
OCR_MAX_CONCURRENT=5
