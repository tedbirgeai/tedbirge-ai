generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  REPRESENTATIVE
  LAWYER
  CUSTOMER
}

enum LeadStatus {
  NEW
  CONTACTED
  DOCS_PENDING
  DOCS_RECEIVED
  ANALYZED
  OFFER_SENT
  CONTRACT_PENDING
  ASSIGNED_TO_LAWYER
  WON
  LOST
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DocumentType {
  ACCIDENT_REPORT
  HOSPITAL_REPORT
  IDENTITY
  INSURANCE
  OTHER
}

enum DocumentStatus {
  UPLOADED
  PARSED
  ANALYZED
  FAILED
}

enum ContractType {
  SERVICE_AGREEMENT
  POWER_OF_ATTORNEY
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  CANCELLED
}

// Kayıt sırasında telefon OTP doğrulaması için geçici kayıt
model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String
  code      String
  purpose   String   @default("kayit")
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model User {
  id             String       @id @default(cuid())
  fullName       String
  email          String       @unique
  phone          String?
  passwordHash   String
  role           Role         @default(CUSTOMER)
  isActive           Boolean      @default(true)
  resetToken         String?
  resetTokenExpires  DateTime?
  sozlesmeKabulTarihi DateTime?
  sonGirisTarihi     DateTime?
  // Hukukçu kayıt alanları
  baroSicilNo        String?
  uzmanlik           String?
  hukukcuKomisyon    Float?       @default(20)
  // Temsilci kayıt alanları
  primOrani          Float?       @default(5)
  bolge              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  ownedLeads         Lead[]             @relation("LeadOwner")
  assignedLeads      Assignment[]       @relation("AssignedLawyer")
  chatSessions       ChatSession[]
  contracts          Contract[]         @relation("ContractCreatedBy")
  petitions          Petition[]         @relation("PetitionCreatedBy")
  pushSubscriptions  PushSubscription[]
}

model Lead {
  id                    String        @id @default(cuid())
  leadCode              String        @unique
  customerName          String
  customerPhone         String
  customerEmail         String?
  accidentDate          DateTime?
  city                  String?
  injurySeverity        String?
  accidentSummary       String?
  status                LeadStatus    @default(NEW)
  estimatedCompensation Float?
  komisyonOrani         Float?        @default(20)
  qualificationScore    Int           @default(0)
  salesNote             String?
  aiSummary             String?
  whatsappRedirected    Boolean       @default(false)
  kvkkConsentAt         DateTime?
  accidentType          String?
  age                   Int?
  monthlyIncome         Float?
  maluliyetRate         Float?
  faultRate             Float?
  // GÖREV 5 — Kullanıcı girişli kesin değerler
  maluliyetOrani        Float?       // Kullanıcı/avukat onaylı maluliyet oranı (0–1)
  kusurOrani            Float?       // Kullanıcı/avukat onaylı kusur oranı (0–1)
  gercekTazminat        Float?       // Kesinleşen tazminat miktarı (TL)
  yaralanmaTuru         String?      // AMA kılavuzu yaralanma türü
  uyapDosyaNo           String?
  uyapMahkeme           String?
  uyapDurum             String?
  uyapSonGuncelleme     DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  ownerId               String?
  owner                 User?         @relation("LeadOwner", fields: [ownerId], references: [id])

  chatSessions          ChatSession[]
  messages              ChatMessage[]
  documents             Document[]
  assignments           Assignment[]
  contracts             Contract[]
  activities            ActivityLog[]
  ihtarnameler          IhtarnameTakip[]
  davaSurec             DavaSurec?
  durusmalar            Durusma[]
  bilirkisiIslemleri    Bilirkisi[]
  masraflar             Masraf[]
  petitions             Petition[]
}

model IhtarnameTakip {
  id              String    @id @default(cuid())
  leadId          String
  lead            Lead      @relation(fields: [leadId], references: [id])
  gonderimTarihi  DateTime?
  karsiTaraf      String?
  tur             String    @default("SIGORTA")
  durum           String    @default("HAZIRLANIYOR")
  cevapTarihi     DateTime?
  cevapIcerigi    String?
  teklifTutari    Float?
  teklifTarihi    DateTime?
  sonrakiAdim     String?
  notlar          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model DavaSurec {
  id                String    @id @default(cuid())
  leadId            String    @unique
  lead              Lead      @relation(fields: [leadId], references: [id])
  asama             String    @default("HAZIRLIK")
  mahkeme           String?
  dosyaNo           String?
  davaTarihi        DateTime?
  davaTuru          String?
  karsiTaraf        String?
  bilirkisiVar      Boolean   @default(false)
  bilirkisiRapor    String?
  uzlasmaDenemesi   Int       @default(0)
  uzlasmaTeklif     Float?
  karar             String?
  kararTarihi       DateTime?
  istinafVar        Boolean   @default(false)
  yargitayVar       Boolean   @default(false)
  icraTakibi        Boolean   @default(false)
  tahsilatTutar     Float?
  masraflar         Float     @default(0)
  notlar            String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Durusma {
  id           String    @id @default(cuid())
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id])
  tarih        DateTime
  mahkeme      String?
  saat         String?
  tur          String    @default("DURUSMA")
  aciklama     String?
  hatirlatildi Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model Bilirkisi {
  id             String    @id @default(cuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id])
  atamaTarihi    DateTime?
  teslimTarihi   DateTime?
  raporGeldiMi   Boolean   @default(false)
  raporTarihi    DateTime?
  raporIcerigi   String?
  aiAnalizi      String?
  itirazEdildi   Boolean   @default(false)
  itirazTarihi   DateTime?
  itirazIcerigi  String?
  createdAt      DateTime  @default(now())
}

model Masraf {
  id        String    @id @default(cuid())
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id])
  tur       String
  tutar     Float
  tarih     DateTime  @default(now())
  aciklama  String?
  odendi    Boolean   @default(false)
  createdAt DateTime  @default(now())
}

model ChatSession {
  id          String        @id @default(cuid())
  sessionKey  String        @unique
  leadId      String?
  userId      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lead        Lead?         @relation(fields: [leadId], references: [id])
  user        User?         @relation(fields: [userId], references: [id])
  messages    ChatMessage[]
}

model ChatMessage {
  id            String       @id @default(cuid())
  sessionId     String?
  leadId        String?
  sender        String
  message       String
  metadataJson  String?
  createdAt     DateTime     @default(now())

  session       ChatSession? @relation(fields: [sessionId], references: [id])
  lead          Lead?        @relation(fields: [leadId], references: [id])
}

model Document {
  id            String         @id @default(cuid())
  leadId        String
  uploadedById  String?
  type          DocumentType   @default(OTHER)
  status        DocumentStatus @default(UPLOADED)
  originalName  String
  storedName    String
  mimeType      String
  sizeBytes     Int
  path          String
  parsedText          String?
  aiAnalysis          String?
  extractedJson       String?
  storageKey          String?
  compensationResult  String?
  pageCount           Int?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  lead          Lead           @relation(fields: [leadId], references: [id])
}

model Assignment {
  id         String           @id @default(cuid())
  leadId     String
  lawyerId   String
  note       String?
  status     AssignmentStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  lead       Lead             @relation(fields: [leadId], references: [id])
  lawyer     User             @relation("AssignedLawyer", fields: [lawyerId], references: [id])
}

model Contract {
  id          String         @id @default(cuid())
  leadId      String
  createdById String?
  type        ContractType
  status      ContractStatus @default(DRAFT)
  title       String
  content     String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  musteriOnayladi   Boolean   @default(false)
  musteriOnayTarihi DateTime?
  onayKodu          String?
  onayKoduExpires   DateTime?

  lead        Lead           @relation(fields: [leadId], references: [id])
  createdBy   User?          @relation("ContractCreatedBy", fields: [createdById], references: [id])
}

model Petition {
  id             String    @id @default(cuid())
  leadId         String
  lead           Lead      @relation(fields: [leadId], references: [id])
  avukatId       String?
  createdById    String?
  createdBy      User?     @relation("PetitionCreatedBy", fields: [createdById], references: [id])
  tur            String
  icerik         String
  pdfUrl         String?
  durum          String    @default("TASLAK")
  gonderildi     Boolean   @default(false)
  gonderimTarihi DateTime?
  muhatap        String?
  notlar         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ActivityLog {
  id         String    @id @default(cuid())
  leadId     String?
  action     String
  detail     String?
  createdAt  DateTime  @default(now())

  lead       Lead?     @relation(fields: [leadId], references: [id])
}

model VerificationToken {
  id         String    @id @default(cuid())
  token      String    @unique
  email      String
  type       String    @default("EMAIL_VERIFY")
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
