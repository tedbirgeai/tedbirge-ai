generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// @deferred — AI Kaza Rekonstruksiyon ozelligi (Madde 33) — AI Analiz Dogruluk Kesiti'nde aktif edilecek (Q3 2026)
model AccidentCase {
  id           String             @id @default(cuid())
  leadId       String
  status       AccidentCaseStatus @default(DRAFT)
  summary      String?
  analysisData Json?
  reportData   Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  analyzedAt   DateTime?
  Lead         Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  Evidence     Evidence[]

  @@index([leadId])
  @@index([status])
}

model ActivityLog {
  id        String   @id @default(cuid())
  leadId    String?
  action    String
  detail    String?
  createdAt DateTime @default(now())
  Lead      Lead?    @relation(fields: [leadId], references: [id])
}

model Assignment {
  id        String           @id @default(cuid())
  leadId    String
  lawyerId  String
  note      String?
  status    AssignmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  lawyer    User             @relation(fields: [lawyerId], references: [id])
  lead      Lead             @relation(fields: [leadId], references: [id])
}

model Bilirkisi {
  id            String    @id @default(cuid())
  leadId        String
  atamaTarihi   DateTime?
  teslimTarihi  DateTime?
  raporGeldiMi  Boolean   @default(false)
  raporTarihi   DateTime?
  raporIcerigi  String?
  aiAnalizi     String?
  itirazEdildi  Boolean   @default(false)
  itirazTarihi  DateTime?
  itirazIcerigi String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  Lead          Lead      @relation(fields: [leadId], references: [id])
}

model ChatMessage {
  id           String       @id @default(cuid())
  sessionId    String?
  leadId       String?
  sender       String
  message      String
  metadataJson String?
  createdAt    DateTime     @default(now())
  Lead         Lead?        @relation(fields: [leadId], references: [id])
  ChatSession  ChatSession? @relation(fields: [sessionId], references: [id])
}

model ChatSession {
  id         String        @id @default(cuid())
  sessionKey String        @unique
  leadId     String?
  userId     String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  messages   ChatMessage[]
  Lead       Lead?         @relation(fields: [leadId], references: [id])
  User       User?         @relation(fields: [userId], references: [id])
}

model Contract {
  id                String         @id @default(cuid())
  leadId            String
  createdById       String?
  type              ContractType
  status            ContractStatus @default(DRAFT)
  title             String
  content           String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  musteriOnayTarihi DateTime?
  musteriOnayladi   Boolean        @default(false)
  onayKodu          String?
  onayKoduExpires   DateTime?
  User              User?          @relation(fields: [createdById], references: [id])
  Lead              Lead           @relation(fields: [leadId], references: [id])
}

model DavaSurec {
  id              String    @id @default(cuid())
  leadId          String    @unique
  asama           String    @default("HAZIRLIK")
  mahkeme         String?
  dosyaNo         String?
  davaTarihi      DateTime?
  davaTuru        String?
  karsiTaraf      String?
  bilirkisiVar    Boolean   @default(false)
  bilirkisiRapor  String?
  uzlasmaDenemesi Int       @default(0)
  uzlasmaTeklif   Float?
  karar           String?
  kararTarihi     DateTime?
  istinafVar      Boolean   @default(false)
  yargitayVar     Boolean   @default(false)
  icraTakibi      Boolean   @default(false)
  tahsilatTutar   Float?
  masraflar       Float     @default(0)
  notlar          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  Lead            Lead      @relation(fields: [leadId], references: [id])
}

model Document {
  id                 String         @id @default(cuid())
  leadId             String
  uploadedById       String?
  type               DocumentType   @default(OTHER)
  status             DocumentStatus @default(UPLOADED)
  originalName       String
  storedName         String
  mimeType           String
  sizeBytes          Int
  path               String
  parsedText         String?
  aiAnalysis         String?
  extractedJson      String?
  storageKey         String?
  compensationResult String?
  pageCount          Int?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?
  Lead               Lead           @relation(fields: [leadId], references: [id])
}

model Durusma {
  id           String   @id @default(cuid())
  leadId       String
  tarih        DateTime
  mahkeme      String?
  saat         String?
  tur          String   @default("DURUSMA")
  aciklama     String?
  hatirlatildi Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Lead         Lead     @relation(fields: [leadId], references: [id])
}

// @deferred — AccidentCase ile birlikte gelir (Madde 33)
model Evidence {
  id             String       @id @default(cuid())
  accidentCaseId String
  type           EvidenceType
  fileUrl        String?
  fileName       String?
  fileMimeType   String?
  fileSize       Int?
  metadata       Json?
  notes          String?
  uploadedAt     DateTime     @default(now())
  AccidentCase   AccidentCase @relation(fields: [accidentCaseId], references: [id], onDelete: Cascade)

  @@index([accidentCaseId])
  @@index([type])
}

model IhtarnameTakip {
  id             String    @id @default(cuid())
  leadId         String
  gonderimTarihi DateTime?
  karsiTaraf     String?
  tur            String    @default("SIGORTA")
  durum          String    @default("HAZIRLANIYOR")
  cevapTarihi    DateTime?
  cevapIcerigi   String?
  sonrakiAdim    String?
  notlar         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  teklifTarihi   DateTime?
  teklifTutari   Float?
  Lead           Lead      @relation(fields: [leadId], references: [id])
}

model Lead {
  id                    String           @id @default(cuid())
  leadCode              String           @unique
  customerName          String
  customerPhone         String
  customerEmail         String?
  accidentDate          DateTime?
  city                  String?
  injurySeverity        String?
  accidentSummary       String?
  status                LeadStatus       @default(NEW)
  estimatedCompensation Float?
  qualificationScore    Int              @default(0)
  salesNote             String?
  aiSummary             String?
  whatsappRedirected    Boolean          @default(false)
  accidentType          String?
  age                   Int?
  monthlyIncome         Float?
  maluliyetRate         Float?
  faultRate             Float?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  ownerId               String?
  kvkkConsentAt         DateTime?
  uyapDosyaNo           String?
  uyapDurum             String?
  uyapMahkeme           String?
  uyapSonGuncelleme     DateTime?
  komisyonOrani         Float?           @default(20)
  gercekTazminat        Float?
  kusurOrani            Float?
  maluliyetOrani        Float?
  yaralanmaTuru         String?
  createdById           String?
  odemeDetay            String?
  hakEdisNotu           String?
  hakEdisStatus         String?          @default("BEKLEMEDE")
  hakEdisTarihi         DateTime?
  hakEdisTetikleyenId   String?
  kdvTutari             Float?           @default(0)
  masrafTutari          Float?           @default(0)
  muhatapTipi           MuhatapTipi?
  muhatapAdi            String?
  muhatapTespitKaynagi  String?
  muhatapGuvenSkoru     Float?
  muhatapGerekce        String?          @db.Text
  healthDataConsentAt   DateTime?
  archivedAt            DateTime?
  deletedAt             DateTime?
  source                String?
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  utmTerm               String?          // Google Ads keyword
  utmContent            String?          // A/B test varyanti / banner ID
  referrer              String?          // document.referrer
  landingPage           String?          // Ilk gelinen URL (path)
  gclid                 String?          // Google Click ID (server-side conversion)
  AccidentCase          AccidentCase[]
  activities            ActivityLog[]
  assignments           Assignment[]
  Bilirkisi             Bilirkisi[]
  messages              ChatMessage[]
  ChatSession           ChatSession[]
  contracts             Contract[]
  davaSurec             DavaSurec?
  documents             Document[]
  durusmalar            Durusma[]
  ihtarnameler          IhtarnameTakip[]
  createdBy             User?            @relation("Lead_createdByIdToUser", fields: [createdById], references: [id])
  owner                 User?            @relation("Lead_ownerIdToUser", fields: [ownerId], references: [id])
  Masraf                Masraf[]
  Petition              Petition[]
  uyapDosyaSyncs        UYAPDosyaSync[]  @relation("UYAPDosyaSyncs")
  commissionLogs        CommissionLog[]

  // TUR #55 — KIRMIZI #3 AI onay + aciliyet + sade ozet
  aiAnalizOnay          AiAnalizOnay?
  aiAnalizOnayBy        String?
  aiAnalizOnayAt        DateTime?
  aiAnalizOnayNote      String?          @db.Text
  publicSummary         String?          @db.Text
  aciliyet              AciliyetSeviye   @default(NORMAL)
}

model Masraf {
  id        String   @id @default(cuid())
  leadId    String
  tur       String
  tutar     Float
  tarih     DateTime @default(now())
  aciklama  String?
  odendi    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Lead      Lead     @relation(fields: [leadId], references: [id])
}

model Petition {
  id             String    @id @default(cuid())
  leadId         String
  avukatId       String?
  createdById    String?
  tur            String
  icerik         String
  pdfUrl         String?
  durum          String    @default("TASLAK")
  gonderildi     Boolean   @default(false)
  gonderimTarihi DateTime?
  muhatap        String?
  notlar         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  User           User?     @relation(fields: [createdById], references: [id])
  Lead           Lead      @relation(fields: [leadId], references: [id])
}

model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String
  code      String
  purpose   String   @default("kayit")
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                         String               @id @default(cuid())
  fullName                   String
  email                      String               @unique
  phone                      String?
  passwordHash               String
  role                       Role                 @default(CUSTOMER)
  isActive                   Boolean              @default(true)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  resetToken                 String?
  resetTokenExpires          DateTime?
  sonGirisTarihi             DateTime?
  sozlesmeKabulTarihi        DateTime?
  baroSicilNo                String?
  bolge                      String?
  hukukcuKomisyon            Float?               @default(20)
  primOrani                  Float?               @default(50)
  uzmanlik                   String?
  baroOnayDurumu             String?              @default("BEKLEMEDE")
  temsilciOnayDurumu         String?              @default("BEKLEMEDE")
  twoFactorEnabled           Boolean              @default(false)
  twoFactorSecret            String?
  sozlesmeKabulIp            String?
  sozlesmeMetniHash          String?
  sozlesmeVersiyonu          String?              @default("v1.0-temsilci")
  assignments                Assignment[]
  ChatSession                ChatSession[]
  Contract                   Contract[]
  createdLeads               Lead[]               @relation("Lead_createdByIdToUser")
  Lead_Lead_ownerIdToUser    Lead[]               @relation("Lead_ownerIdToUser")
  Petition                   Petition[]
  PushSubscription           PushSubscription[]
  uyapSessions               UYAPSession[]        @relation("UYAPSessions")
  uyapTebligatlar            UYAPTebligat[]       @relation("UYAPTebligatlar")
  sbmSorgular                SBMSorgu[]           @relation("SBMSorgular")
  aiUsageLogs                AIUsageLog[]         @relation("AIUsageLogs")
  dataSubjectRequestsHandled DataSubjectRequest[] @relation("DataSubjectRequestsHandled")

  // TUR #52 — Komisyon + sistem ayarı izleme
  temsilciKomisyonlari       CommissionLog[]      @relation("TemsilciKomisyon")
  settingsUpdated            SystemSetting[]      @relation("SettingsUpdater")

  // TUR #55 — KIRMIZI #1 IBAN + vergi + tasarım tercihleri
  iban             String?
  vergiKimlikNo    String?
  vergiDairesi     String?
  preferences      Json?

  // TUR #55 — Real-time hedef
  realtimeEvents   RealtimeEvent[]  @relation("RealtimeEventTarget")
}

model VerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  type      String    @default("EMAIL_VERIFY")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

enum AccidentCaseStatus {
  DRAFT
  EVIDENCE_READY
  ANALYZING
  COMPLETED
  FAILED
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  SENT
  SIGNED
  CANCELLED
}

enum ContractType {
  SERVICE_AGREEMENT
  POWER_OF_ATTORNEY
}

enum DocumentStatus {
  UPLOADED
  PARSED
  ANALYZED
  FAILED
}

enum DocumentType {
  ACCIDENT_REPORT
  HOSPITAL_REPORT
  IDENTITY
  INSURANCE
  OTHER
}

enum EvidenceType {
  SCENE_PHOTO
  VEHICLE_PHOTO
  POLICE_REPORT
  SATELLITE_IMAGE
  COORDINATES
  VEHICLE_INFO
  VIDEO
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  DOCS_PENDING
  DOCS_RECEIVED
  ANALYZED
  OFFER_SENT
  CONTRACT_PENDING
  ASSIGNED_TO_LAWYER
  WON
  LOST
}

enum MuhatapTipi {
  // Trafik / Araç
  TRAFIK_SIGORTASI
  KASKO
  FERDI_KAZA_KOLTUK
  TMTB
  GUVENCE_HESABI

  // İş / SGK
  ISVEREN
  SGK

  // Sağlık
  HASTANE

  // Tarım ve Afet
  TARSIM
  DASK

  // Genel
  SORUMLU_UCUNCU_KISI
  KAMU_KURUMU

  DIGER
}

enum Role {
  ADMIN
  SALES
  LAWYER
  CUSTOMER
  REPRESENTATIVE
}

// ─── Tedbirge OS v3 Models ──────────────────────────────────────────────────

// Policy storage — desired state deklaratif konfigürasyonu
model OSPolicy {
  id        String   @id @default(cuid())
  module    String
  key       String
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([module, key])
  @@index([module])
}

// Idempotency cache — çift tıklama / retry güvenliği
model IdempotencyKey {
  key       String   @id
  response  Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// System events — tüm OS aksiyonlarının olay kaydı (KVKK audit)
model SystemEvent {
  id        String   @id @default(cuid())
  type      String
  severity  String
  module    String?
  payload   Json
  actorId   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([severity, createdAt])
  @@index([actorId, createdAt])
}

// Metrics time-series — 4 Golden Signals
model SystemMetric {
  id        String   @id @default(cuid())
  name      String
  value     Float
  tags      Json?
  timestamp DateTime

  @@index([name, timestamp])
  @@index([timestamp])
}

// Distributed traces — OpenTelemetry uyumlu
model Trace {
  traceId    String   @id
  rootSpan   Json
  spans      Json
  durationMs Int
  status     String
  service    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
}

// Boot records — her server restart sonucu
model BootRecord {
  id        String   @id @default(cuid())
  steps     Json
  totalMs   Int
  ok        Boolean
  version   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ok])
}

// ─── UYAP Models ────────────────────────────────────────────────────────────

model UYAPSession {
  id            String   @id @default(cuid())
  lawyerId      String
  lawyer        User     @relation("UYAPSessions", fields: [lawyerId], references: [id])
  sessionToken  String   @unique
  expiresAt     DateTime
  lastRefreshAt DateTime @default(now())
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([lawyerId, active])
  @@index([expiresAt])
}

model UYAPDosyaSync {
  id            String   @id @default(cuid())
  leadId        String
  lead          Lead     @relation("UYAPDosyaSyncs", fields: [leadId], references: [id])
  dosyaNo       String   @unique
  mahkeme       String
  durum         String
  sonGuncelleme DateTime
  fullPayload   Json
  syncedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([leadId])
  @@index([syncedAt])
}

model UYAPTebligat {
  id           String   @id @default(cuid())
  lawyerId     String
  lawyer       User     @relation("UYAPTebligatlar", fields: [lawyerId], references: [id])
  dosyaNo      String
  tebligatTipi String
  icerik       String   @db.Text
  receivedAt   DateTime @default(now())
  readByLawyer Boolean  @default(false)
  linkedLeadId String?
  updatedAt    DateTime @updatedAt

  @@index([lawyerId, readByLawyer])
  @@index([dosyaNo])
}

// ─── SBM Models ─────────────────────────────────────────────────────────────

model SBMSorgu {
  id           String   @id @default(cuid())
  sorguTipi    String
  sorguAnahtar String
  sonuc        Json
  sorguMode    String
  sorgulayanId String
  sorgulayan   User     @relation("SBMSorgular", fields: [sorgulayanId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sorguTipi, sorguAnahtar])
  @@index([sorgulayanId])
  @@index([createdAt])
}

// ─── KVKK Models ────────────────────────────────────────────────────────────

// KVKK Standart Sözleşme (SCC) takibi — yurt dışı aktarım uyumu
model KVKKSCC {
  id              String    @id @default(cuid())
  dataProcessor   String
  country         String
  sccSignedAt     DateTime
  kurulBildirimAt DateTime?
  bildirimBelge   String?
  expiresAt       DateTime?
  status          String
  notlar          String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, expiresAt])
  @@index([dataProcessor])
}

// KVKK AI kullanım logu — algoritmik şeffaflık, denetim izi
model AIUsageLog {
  id         String   @id @default(cuid())
  leadId     String?
  userId     String
  user       User     @relation("AIUsageLogs", fields: [userId], references: [id])
  aiService  String
  purpose    String
  inputSize  Int
  outputSize Int
  dataSent   String   @db.Text
  latencyMs  Int?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([leadId])
  @@index([purpose, createdAt])
}

// Data Subject Request — KVKK ilgili kişi hakları
model DataSubjectRequest {
  id           String    @id @default(cuid())
  requesterTC  String
  requestType  String
  description  String    @db.Text
  receivedAt   DateTime  @default(now())
  respondedAt  DateTime?
  status       String
  handlerId    String?
  handler      User?     @relation("DataSubjectRequestsHandled", fields: [handlerId], references: [id])
  responseNote String?   @db.Text
  updatedAt    DateTime  @updatedAt

  @@index([status, receivedAt])
  @@index([requesterTC])
}

// ─── KVKK m.10 + m.7 + m.11 — Madde 25.7 + Madde 18.3 ───────────────
// TUR #49 (30 Nisan 2026) — Calisan Adayi Basvurusu kalici kayit
// CEO Mehmet DINC yazili onay (Madde 18.3):
//   "KAHVEMI YAPARKEN UCTAN UCA TUR #49 BASLA BITIR"
//   "DOSYAYI INDIRDIM KAHVEYI YAPTIM CLAUDE CODE YES NO SORMASIN"
model CareerApplication {
  id                          String              @id @default(cuid())
  fullName                    String
  email                       String
  phone                       String?
  position                    String
  cvLink                      String?
  message                     String?

  // KVKK kanit izi (m.10 aydinlatma + 2018/90 ayri timestamp)
  aydinlatmaOnayTimestamp     DateTime
  acikRizaOnayTimestamp       DateTime
  cvHavuzuOnay                Boolean             @default(false)

  // Operasyonel
  status                      CareerApplicationStatus @default(NEW)
  reviewNote                  String?
  reviewedAt                  DateTime?

  // Audit
  ipAddress                   String?
  userAgent                   String?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  // KVKK m.7 silme talebi (soft delete)
  deletionRequestedAt         DateTime?
  deletedAt                   DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

enum CareerApplicationStatus {
  NEW
  REVIEWED
  CONTACTED
  HIRED
  REJECTED
  DELETED
}

// ─── Madde 24.3 + Madde 18.3 (TUR #52, 30 Nisan 2026) ───────────────
// CommissionLog — Tahsilat → komisyon kayıt zinciri
// CEO Mehmet DINC yazili onay (Madde 18.3): TUR #52 mektubu kabulu
model CommissionLog {
  id              String           @id @default(cuid())
  leadId          String
  lead            Lead             @relation(fields: [leadId], references: [id])
  tahsilatBrut    Decimal          @db.Decimal(12, 2)
  tedbirgeOrani   Decimal          @default(20.00) @db.Decimal(5, 2)
  tedbirgeNet     Decimal          @db.Decimal(12, 2)
  temsilciId      String?
  temsilci        User?            @relation("TemsilciKomisyon", fields: [temsilciId], references: [id])
  temsilciNet     Decimal?         @db.Decimal(12, 2)
  durum           CommissionStatus @default(BEKLIYOR)
  havaleAt        DateTime?
  havaleReferans  String?
  notes           String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([leadId])
  @@index([temsilciId])
  @@index([durum])
  @@index([createdAt])
}

enum CommissionStatus {
  BEKLIYOR
  HESAPLANDI
  HAVALE_EDILDI
  IPTAL
}

// SystemSetting — ADMIN UI'dan ayarlanabilir sistem konfigürasyonu (TUR #52)
// AI guven skoru, bildirim sablonlari, GA4/Cookie ayar referanslari
model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  category    String
  description String?  @db.Text
  updatedBy   String?
  updater     User?    @relation("SettingsUpdater", fields: [updatedBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// ─── TUR #55 — KIRMIZI #3 + #4 ───────────────
enum AiAnalizOnay {
  BEKLIYOR
  ONAYLI
  REDDEDILDI
  GEREKLI_DEGIL
}

enum AciliyetSeviye {
  DUSUK
  NORMAL
  ACIL
  KRITIK
}

// Otonom Katman (Auditor + Healer + Reporter) olay kayıdı
model AgentEvent {
  id          String              @id @default(cuid())
  agentName   String
  eventType   String
  severity    AgentEventSeverity  @default(INFO)
  payload     Json
  createdAt   DateTime            @default(now())

  @@index([agentName, createdAt])
  @@index([severity])
  @@index([createdAt])
}

enum AgentEventSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

// Real-time canlı feed (SSE)
model RealtimeEvent {
  id          String   @id @default(cuid())
  channel     String
  eventType   String
  payload     Json
  userId      String?
  user        User?    @relation("RealtimeEventTarget", fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  consumed    Boolean  @default(false)

  @@index([channel, createdAt])
  @@index([userId, consumed])
}
